{
  "name": "@codemeall/harness-bridge",
  "version": "0.4.0",
  "description": "Hand off AI coding-agent sessions through one markdown file, and recover sessions another agent could not finish: /handoff, /pickup and /recover-session skills plus a local CLI and MCP server.",
  "type": "module",
  "bin": {
    "harness-bridge": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "docs",
    "prompts",
    "providers",
    "templates",
    "SPEC.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "yaml": "^2.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "keywords": [
    "ai",
    "agents",
    "handoff",
    "claude-code",
    "codex",
    "cursor",
    "gemini",
    "mcp",
    "skills",
    "antigravity",
    "opencode",
    "session-recovery"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codemeall/harness-bridge.git"
  },
  "homepage": "https://github.com/codemeall/harness-bridge#readme"
}
